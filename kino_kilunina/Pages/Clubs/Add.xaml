<Page x:Class="kino_kilunina.Pages.Clubs.Add"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:kino_kilunina.Pages.Clubs"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Add">

    <Grid Margin="10" Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100px"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Width="80" Height="80" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10" Source="/Images/ic-club.png"/>
        <Button x:Name="BtnAdd" Click="AddClub" Height="25" Content="Добавить" VerticalAlignment="Top" Margin="10,95,10,0" Background="#FF46FD00" BorderBrush="#FF46FD00" Foreground="white"/>

        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label VerticalAlignment="top" Margin="10,10,10,0" Content="Наименование:"/>
            <TextBox x:Name="Name" Text="" VerticalAlignment="top" Margin="10,35,10,0" Height="25" VerticalContentAlignment="Center"/>

            <Label VerticalAlignment="top" Margin="10,65,10,0" Content="Адрес:"/>
            <TextBox x:Name="Address" Text="" VerticalAlignment="top" Margin="10,90,10,0" Height="25" VerticalContentAlignment="Center"/>

            <Label VerticalAlignment="top" Margin="10,10,10,0" Content="Время работы:" Grid.Column="1"/>
            <TextBox x:Name="WorkTime" Text="" VerticalAlignment="top" Grid.Column="1" Margin="10,35,10,0" Height="80" VerticalContentAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
